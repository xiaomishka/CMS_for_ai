<h1 class="page-title"><?= $view->e($category['title'] ?? '') ?></h1>
<?php if (!empty($category['description'] ?? '')): ?>
<p class="description"><?= $view->e($category['description']) ?></p>
<?php endif; ?>

<?php if (empty($articles)): ?>
<p>В этой рубрике пока нет статей.</p>
<?php else: ?>
<?php foreach ($articles as $a): ?>
<article class="post-item">
  <h2><a href="<?= $view->e($a['url']) ?>"><?= $view->e($a['title']) ?></a></h2>
  <?php if (!empty($a['cover'])): ?>
    <img class="post-cover" src="<?= $view->e($a['cover']) ?>" alt="<?= $view->e($a['title']) ?>">
  <?php endif; ?>
  <p><?= $view->e($a['short']) ?></p>
  <time><?= $view->e(date('d.m.Y', strtotime($a['date'] ?? ''))) ?></time>
</article>
<?php endforeach; ?>

<?php if (!empty($pagination['prev_url'])): ?>
<a href="<?= $view->e($pagination['prev_url']) ?>">‹ Назад</a>
<?php endif; ?>
<?php if (!empty($pagination['next_url'])): ?>
<a href="<?= $view->e($pagination['next_url']) ?>">Вперед ›</a>
<?php endif; ?>
<?php endif; ?>
