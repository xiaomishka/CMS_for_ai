# Рантайм-файлы (создаются после установки)
core/config.php
core/*.sqlite
core/*.sqlite-*
core/cache/
core/*.log
install.done.php

# Системное
Thumbs.db
.DS_Store

# Сборочный инструмент Tailwind (admin/assets/admin.css — входит в пакет)
tools/tailwindcss.exe

# Пользовательские темы (создаются адаптацией HTML-шаблонов) не попадают в git.
# В репозитории поставляются только встроенные темы: default, ai-adapted, phtml-example.
/templates/*
!/templates/default/
!/templates/ai-adapted/
!/templates/phtml-example/

# Пользовательские загрузки (медиафайлы из админки) не попадают в git.
/uploads/*
!/uploads/.htaccess
